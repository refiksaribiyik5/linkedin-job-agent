# LinkedInBot - Ortam Degiskenleri Sablonu
#
# TDD Section 13 ("Konfigurasyon Mimarisi") geregi, ortam degiskenleri YALNIZCA
# altyapi ayarlari icindir (DB baglantisi, log seviyesi vb.). Is kurallari
# (esikler, agirliklar, departman listesi, cizelge, bildirim ayarlari, rapor
# formati vb.) asla burada tutulmaz -- bunlar hesap basina versiyonlanmis olarak
# account_config_profiles tablosunda saklanir (bkz. PRD Section 17, 17.1).
#
# Secrets (LLM API anahtari, LinkedIn oturum verisi) de burada TUTULMAZ; bunlar
# SecretsProvider araciligiyla ayrica yonetilir (bkz. TDD Section 24).
#
# Kullanim: bu dosyayi ".env" olarak kopyalayip gercek degerlerle doldurun.
# ".env" asla commit edilmez (bkz. .gitignore).

# PostgreSQL baglanti dizesi (bkz. TDD Section 15). Suruculuk: psycopg (psycopg3),
# SQLAlchemy 2.x ile onerilen modern PostgreSQL suruculugu (bkz. TDD Section 2).
DATABASE_URL=postgresql+psycopg://linkedinbot:changeme@localhost:5432/linkedinbot

# Log seviyesi: DEBUG | INFO | WARNING | ERROR (bkz. TDD Section 19 - loglama M9.4'te kurulur)
LOG_LEVEL=INFO
